{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "PASS1 Outline",
  "description": "Schema for the outline.json produced by PASS1 (per-chunk structured extraction).",
  "type": "object",
  "required": ["tldr", "outline", "mindmap", "key_terms"],
  "additionalProperties": false,
  "properties": {
    "tldr": {
      "type": "string",
      "minLength": 1,
      "description": "3-sentence summary capturing the most important judgments. NOT a flow narrative — a take."
    },
    "outline": {
      "type": "array",
      "minItems": 1,
      "description": "5-12 sections covering the episode. Each timestamp must come from the transcript.",
      "items": {
        "type": "object",
        "required": ["section", "key_points"],
        "additionalProperties": false,
        "properties": {
          "section": {
            "type": "string",
            "minLength": 1,
            "description": "Section title. MUST start with a verb."
          },
          "timestamp": {
            "type": "string",
            "pattern": "^([0-9]{1,2}:)?[0-9]{1,2}:[0-9]{2}$",
            "description": "Start time from the transcript in HH:MM:SS or MM:SS format."
          },
          "key_points": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "One-sentence bullet points for this section."
          },
          "worth_listening": {
            "type": "boolean",
            "default": true,
            "description": "false for ads, intros, off-topic chatter, sponsorships."
          },
          "skip_reason": {
            "type": "string",
            "description": "Why this section can be skipped (only meaningful when worth_listening is false). Empty string otherwise."
          }
        }
      }
    },
    "mindmap": {
      "description": "Structured mind map with 3-7 top-level branches, each with 2-5 children. Can also be a raw Mermaid string.",
      "oneOf": [
        {
          "type": "object",
          "required": ["root", "branches"],
          "additionalProperties": false,
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1,
              "description": "Central topic (concise)."
            },
            "branches": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["label", "children"],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Branch label (<=8 Chinese chars or <=4 English words)."
                  },
                  "children": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["label"],
                      "additionalProperties": false,
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Sub-point text."
                        },
                        "timestamp": {
                          "type": "string",
                          "description": "Timestamp in MM:SS or HH:MM:SS format."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "string",
          "description": "Raw Mermaid mindmap syntax."
        }
      ]
    },
    "key_terms": {
      "type": "array",
      "description": "Only terms that are LOAD-BEARING in this episode. The 'term' field preserves original wording.",
      "items": {
        "type": "object",
        "required": ["term"],
        "additionalProperties": false,
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1,
            "description": "Original term — do NOT translate this field."
          },
          "translation": {
            "type": "string",
            "description": "Translation in the output language."
          },
          "explanation": {
            "type": "string",
            "description": "One sentence explaining why this term matters in this episode."
          }
        }
      }
    }
  }
}
